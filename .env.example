# Copy this file to .env and paste your OpenRouter key.
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Text model used to generate questions and grade writing/speaking.
# You may replace this with any OpenRouter model that supports structured JSON.
OPENROUTER_MODEL=google/gemini-2.5-flash

# Dedicated speech-to-text model. Change it if this ID is unavailable on your account.
OPENROUTER_STT_MODEL=openai/whisper-large-v3

# Natural text-to-speech used by Listen and Type and Interactive Listening.
# Automatic voice mode falls back to the best browser voice if this request is unavailable.
OPENROUTER_TTS_MODEL=openai/gpt-4o-mini-tts-2025-12-15
OPENROUTER_TTS_VOICE=alloy
OPENROUTER_TTS_FORMAT=mp3
OPENROUTER_TTS_SPEED=0.96

# Optional provider-specific delivery direction. Keep this on one line in .env.
OPENROUTER_TTS_INSTRUCTIONS=Speak in a clear, warm, natural human voice at a moderate English proficiency test pace. Use neutral pronunciation, realistic phrasing, gentle sentence stress, and short natural pauses. Do not sound theatrical, robotic, rushed, or exaggerated.

# Optional application metadata sent to OpenRouter.
APP_URL=http://localhost:3000
APP_TITLE=ScoreForge 130+

HOST=127.0.0.1
PORT=3000
